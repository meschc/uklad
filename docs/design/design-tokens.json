      "$value": "9999px"
    }
  },
  "radiusSite": {
    "$description": "Шкала витрины (src/site/site.css). Живёт только в бандле сайта. Цепочка: плита 32 → p-3 → окно 20 → p-2 → вставка 12 → p-1 → плашка 8.",
    "slab": {
      "$type": "borderRadius",
      "$value": "32px",
      "$description": "Плита-сцена: герой, блок во всю ширину. 24px на ≤640."
    },
    "window": {
      "$type": "borderRadius",
      "$value": "20px",
      "$description": "Окно внутри плиты, карточка склада, панель. 16px на ≤640."
