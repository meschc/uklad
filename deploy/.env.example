# Образец настроек сервера. Скопируйте в `.env` и заполните:
#   cp .env.example .env
# Файл `.env` в git не попадает (.gitignore) — пароли живут только на сервере.
# Здесь только заглушки. Настоящих значений в этот файл НЕ вписывать.

# --- Сайт ---
# Домен без https:// и без слэша. Пока DNS не переключён, можно проверочный.
SITE_DOMAIN=u-klad.ru
# Почта для Let's Encrypt: туда напишут, если с сертификатом что-то не так.
ACME_EMAIL=you@example.ru

# --- Админка (admin.<домен>) ---
# С каких адресов её вообще видно, через пробел (IP или сеть: 203.0.113.7/32).
# Остальным — 404. Пусто — админка закрыта всем; тогда входить через
# SSH-туннель (README, раздел «Админка»).
ADMIN_ALLOW_IPS=

# --- Почта, через которую уходят заявки и демо-ссылки ---
# Яндекс 360 для домена: smtp.yandex.ru:465, пароль — «пароль приложения»,
# а не пароль от ящика (id.yandex.ru → Безопасность → Пароли приложений).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=hello@u-klad.ru
SMTP_PASSWORD=заменить-на-пароль-приложения
# Куда приходят заявки.
MAIL_TO=hello@u-klad.ru
# От кого письма (по умолчанию = SMTP_USER).
# MAIL_FROM=Уклад <hello@u-klad.ru>

# --- Сервер заявок (можно не трогать) ---
# Сколько дней хранить заявки в базе; письмо в почте остаётся.
LEADS_RETENTION_DAYS=180
# Обращения «Сообщить о проблеме»: сколько дней хранить и общий потолок за сутки.
REPORTS_RETENTION_DAYS=90
REPORTS_PER_DAY=500
REPORTS_MB_PER_DAY=200
# Сколько дней работает демо-ссылка и сколько писем на один адрес в сутки.
DEMO_LINK_DAYS=14
DEMO_PER_EMAIL_PER_DAY=3
# Лимит частоты на форму с одного адреса: всплеск и пополнение в минуту.
RATE_LIMIT_BURST=5
RATE_LIMIT_PER_MINUTE=2

# --- Кабинет (Postgres, server/db) ---
# Подключение под ролью приложения uklad_app (не владельцем таблиц). Пусто —
# кабинет выключен, сайт и заявки работают как раньше.
# Пример: postgres://uklad_app:пароль@db:5432/uklad
DATABASE_URL=

# Рассылка о непрочитанном и вебхук Телеграм-бота — своим подключением под
# ролью uklad_notifier (server/db/init.sql): у роли приложения этих функций
# нет. Пусто — ни бота, ни писем о непрочитанном.
# Пароль роли — свой (notifier_pw в init.sql), не такой, как у uklad_app:
# случайный, 32+ символа (openssl rand -base64 32).
# Пример: postgres://uklad_notifier:пароль@db:5432/uklad
NOTIFIER_DATABASE_URL=

# --- Чат в реальном времени (Centrifugo) ---
# Адрес HTTP API Centrifugo внутри сети compose, его ключ API и секрет
# токенов подключения (HMAC, не короче 32 символов). Пусто — чат работает,
# но кабинет узнаёт о новых сообщениях опросом, а не мгновенно.
# В compose: http://centrifugo:8000 (сервис уже описан в compose.yml).
CENTRIFUGO_API_URL=
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_SECRET=

# --- Телеграм-бот уведомлений о сообщениях ---
# Отдельный бот от @BotFather, не тот, что у сторожа: у него другие люди.
# Имя бота без @ (для ссылки t.me/<имя>), токен и секрет вебхука (случайная
# строка из букв, цифр, _ и -, 32+ символа). Вебхук сервер ставит сам при
# старте на PUBLIC_URL/api/telegram/webhook. Пусто — бота нет, письма о
# непрочитанном всё равно уходят на подтверждённую почту.
TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Резервные копии (deploy/backup.sh) ---
# Куда класть копии на этом сервере.
BACKUP_DIR=/var/backups/uklad
# Сколько дней хранить.
BACKUP_KEEP_DAYS=30
# Куда отправлять копию на ДРУГУЮ машину (rsync по SSH). Пусто — не отправлять.
# Пример: backup@backup.example.ru:/srv/uklad
BACKUP_REMOTE=
# Публичный ключ age (age1…): копии шифруются перед отправкой. Пусто — без шифрования.
BACKUP_AGE_RECIPIENT=

# --- Сторож (deploy/watchdog.sh) ---
# Бот от @BotFather и ваш чат с ним. Пусто — сторож пишет только в свой вывод.
TG_BOT_TOKEN=
TG_CHAT_ID=
# Порог тревоги по заполнению диска, в процентах.
DISK_ALERT_PERCENT=80
